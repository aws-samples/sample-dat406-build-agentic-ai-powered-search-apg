// Advanced reading exercise: require a successful customer-context lookup
// before initiate_return can run for that same customer in the policy session.
//
// This is Dogwood, the temporal-policy superset of Cedar used by AgentCore
// Policy. It is intentionally not deployed by the required workshop path.
//
// Important: Pellier's baseline_permit_gateway_tools policy permits every
// Gateway action. A production deployment must narrow or replace that broad
// permit before this temporal permit becomes restrictive. Adding this policy
// alongside the broad permit would not enforce the sequence.
permit(
  principal,
  action == AgentCore::Action::"pellier-concierge-experience-target___initiate_return",
  resource is AgentCore::Gateway
)
when {
  principal.hasTag("username") &&
  context.input has customer_id &&
  principal.getTag("username") == context.input.customer_id
}
when temporal {
  formerly within 10m
    AgentCore::Action::"pellier-curation-recommendation-target___get_customer_preferences"::response{
      eventResource: resource,
      input.customer_id: context.input.customer_id
    }
};
